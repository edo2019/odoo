                                </div>
                                <div class="col-8" align="center">
                                    <p>
                                        <strong>
                                            <h5>THE UNITED REPUBLIC OF TANZANIA</h5>
                                        </strong>
                                        <strong>
                                            <h6>MINISTRY OF INDUSTRY AND TRADE</h6>
                                        </strong>
                                        <strong>
                                            <h6>WAREHOUSE RECEIPTS REGULATORY BOARD</h6>
                                        </strong>
                                    </p>
                                </div>
                                <div class="col-2 float-right">
                                    <img t-if="docs.company_id.logo" t-att-src="image_data_uri(docs.company_id.logo)" alt="WRRB Logo"/>
                                </div>
                            </div>
                            <br/>
                            <div class="w-100" align="center">
                                <strong>
                                    <h6>WAREHOUSE RECEIPTS ISSUE NOTE</h6>
                                </strong>
                            </div>
                            <div class="clearfix mb8"/>
                        </div>
                    </div>
                </xpath>

                <xpath expr="//div[hasclass('article')]" position="replace">
                    <div class="article w-100 container">
                        <div class="row w-80 mx-auto mb-2">
                            <div class="col-6">
                                <strong>
                                    <span> Company: </span>
                                </strong>
                                <span t-esc="docs[0].warehouse_id.partner_id.name"/>
                            </div>
                            <div class="col-6 text-right">
                                <strong>
                                    <span>Warehouse Issue Number: </span>
                                </strong>
                                <span t-field="docs[0].origin"/>
                            </div>
                        </div>
                        <div class="row w-80 mx-auto mb-2">
                            <div class="col-12">
                                <strong>
                                    <span> Physical Address: </span>
                                </strong>
                                <span>
                                    <span t-esc="docs[0].warehouse_id.partner_id.street2"/>
                                        , 
                                    <span t-esc="docs[0].warehouse_id.partner_id.street"/>
                                        , 
                                    <span t-esc="docs[0].warehouse_id.partner_id.district_id.name"/>
                                        , 
                                    <span t-esc="docs[0].warehouse_id.partner_id.country_id.name"/>
                                </span>
                            </div>
                        </div>
                        <div class="row w-80 mx-auto mb-4">
                            <div class="col-6">
                                <strong>
                                    <span> Tel.: </span>
                                </strong>
                                <span t-esc="docs[0].warehouse_id.partner_id.phone"/>
                            </div>
                            <div class="col-6 text-right">
                                <strong>
                                    <span>Date: </span>
                                    <span t-esc="docs[0].scheduled_date.strftime('%d-%m-%Y')"/>
                                </strong>
                            </div>
                        </div>

                        <div class="container">
                            <div class="row w-80 mx-auto mb-2">
                                <div class="col-4">
                                    <strong>Buyer Name</strong>
                                </div>
                                <div class="col-8">
                                    <span t-esc="docs[0].partner_id.name"/>
                                </div>
                            </div>
                            <div class="row w-80 mx-auto mb-2">
                                <div class="col-4">
                                    <strong>Warehouse Name</strong>
                                </div>
                                <div class="col-8">
                                    <span t-field="docs[0].warehouse_id.name"/>
                                </div>
                            </div>
                            <div class="row w-80 mx-auto mb-2">
                                <div class="col-4">
                                    <strong>Release Warranty Number</strong>
                                </div>
                                <div class="col-8">
                                    <span t-field="docs[0].warranty_number"/>
                                </div>
                            </div>
                            <div class="row w-80 mx-auto mb-2">
                                <div class="col-4">
                                    <strong>Truck Registration Number</strong>
                                </div>
                                <div class="col-8">
                                    <span t-field="docs[0].transport_line.car_registration"/>
                                </div>
                            </div>
                            <div class="row w-80 mx-auto mb-2">
                                <div class="col-4">
                                    <strong>Truck Driver Name</strong>
                                </div>
                                <div class="col-8">
                                    <span t-field="docs[0].transport_line.name"/>
                                </div>
                            </div>
                        </div>

                        <div class="container w-100 mt-4">
                            <div class="text-center mb-2">
                                <strong>
                                        Commodity Delivery Information
                                </strong>
                            </div>

                            <div>
                                <table class="table table-sm">
                                    <thead>
                                        <th scope="col">No</th>
                                        <th scope="col">Warehouse Receipt No.</th>
                                        <th scope="col">Auction No.</th>
                                        <th scope="col">Order No.</th>
                                        <th scope="col">Depositor</th>
                                        <th scope="col">Commodity Type</th>
                                        <th scope="col">No. of Units</th>
                                        <th scope="col">Net Weight</th>
                                        <th scope="col">Unit Price</th>
                                        <th scope="col">Value</th>
                                    </thead>
                                    <tbody>
                                        <t t-set="count" t-value="1"/>
                                        <t t-set="total_no_units" t-value="0"/>
                                        <t t-set="total_weight" t-value="0"/>
                                        <t t-set="total_value" t-value="0"/>
                                        <t t-foreach="docs" t-as="o">
                                            <t t-set="commodities" t-value="o.move_line_ids"/>
                                            <t t-set="auctions" t-value="o.auction_line"/>

                                            <t t-foreach="auctions" t-as="auction">
                                                <t t-foreach="commodities" t-as="commodity">
                                                    <t t-set="auction_value" t-value="o.qty_done * (auction.price)"/>
                                                    <tr>
                                                        <th>
                                                            <span t-esc="count"/>
                                                        </th>
                                                        <td>
                                                            <span t-field="o.receipt_id"/>
                                                        </td>
                                                        <td>
                                                            <span t-field="auctions.name"/>
                                                        </td>
                                                        <td>
                                                            <span t-field="o.order_number"/>
                                                        </td>
                                                        <td>
                                                            <span t-field="o.depositor.name"/>
                                                        </td>
                                                        <td>
                                                            <span t-field="commodity.product_id"/>
                                                        </td>
                                                        <td>
                                                            <span t-field="o.bag_count"/>
                                                        </td>
                                                        <td>
                                                            <span t-field="o.qty_done"/>
                                                        </td>
                                                        <td>
                                                            <span t-esc="'{:0,.0f}'.format(auction.price)"/>
                                                        </td>
                                                        <td>
                                                            <span t-esc="'{:0,.0f}'.format(auction_value)"/>
                                                        </td>
                                                    </tr>
                                                    <t t-set="total_no_units" t-value="total_no_units + o.bag_count"/>
                                                    <t t-set="total_weight" t-value="total_weight + o.qty_done"/>
                                                    <t t-set="total_value" t-value="total_value + auction_value"/>
                                                    <t t-set="count" t-value="count + 1"/>
                                                </t>
                                            </t>
                                        </t>
                                        <tr>
                                            <th/>
                                            <th>TOTAL</th>
                                            <th/>
                                            <th/>
                                            <th/>
                                            <th/>
                                            <th>
                                                <span t-esc="total_no_units"/>
                                            </th>
                                            <th>
                                                <span t-esc="'{:0,.1f}'.format(total_weight)"/>
                                            </th>
                                            <th/>
                                            <th>
                                                <span t-esc="'{:0,.0f}'.format(total_value)"/>
                                            </th>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <section class="container mx-auto mt-2">
                            <div class="container">
                                <div class="row mb-2">
                                    <div class="col-8">
                                        <span>
                                        <b>Warehouse Manager Name</b> ............................................................................ 
                                        </span>
                                    </div>
                                    <div>
                                        <span class="col-4">
                                        Signature ............................................
                                        </span>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-8">
                                        <span>
                                            <b>Buyer Representative Name:</b>
                                            <span t-if="docs[0].transport_line.escorter_name">
                                                <span t-field="docs[0].transport_line.escorter_name"/>
                                            </span>
                                            <span t-else="">
                                                ...........................................................................
                                            </span>
                                        </span>
                                    </div>
                                    <div class="col-4">
                                        <span>
                                        Signature ...........................................
                                        </span>
                                    </div>
                                </div>
                                <div class="row mb-2">
                                    <div class="col-8">
                                        <span>
                                            <b>Driver Name:</b>
                                            <span t-if="docs[0].transport_line.name">
                                                <span t-field="docs[0].transport_line.name"/>
                                            </span>
                                            <span t-else="">
                                                ....................................................................................................... 
                                            </span>
                                        </span>
                                    </div>

                                    <div class="col-4">
                                        <span>
                                        Signature ...........................................
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="container">
                                <div class="row">
                                    <div class="col-4"/>
                                    <div class="col-4" align="center">
                                        <img t-att-src="'/report/barcode/?type=QR&amp;value=%s/verify/receipt/?receipt_no=%s&amp;width=120&amp;height=120'%(docs[0].get_base_url(),docs[0].receipt_no)"/>
                                        <br/>
                                        <strong class="mt-3">SCAN QR CODE TO VERIFY</strong>
                                    </div>
                                    <div class="col-4"/>
                                </div>
                            </div>
                        </section>
                    </div>
                </xpath>
                <xpath expr="//div[hasclass('footer')]" position="replace">
                    <div class="footer d-none"/>
                </xpath>

            </t>
        </t>
    </template>

    <!--  Receipt document template  -->
    <template id="report_delivery_document_inherit_stock" inherit_id="stock.report_delivery_document">
        <t name="partner_header" position="replace"/>
        <xpath expr="//t/t/div/h2[1]" position="replace"/>
        <xpath expr="//t/t//div/div[hasclass('row') and hasclass('mb32') and hasclass('mt32')]" position="replace">
            <div class="row">
                <div class="col-12" style="margin-top:80px!important;">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <p style="margin-bottom:0px">By this Warehouse Receipt it is confirmed that
                                <strong>
                                    <span t-field="o.picking_type_id.warehouse_id.partner_id.name"/>
                                </strong>
                            </p>
                            <p style="margin-bottom:0px">Located in
                                <strong>
                                    <span t-esc="o.picking_type_id.warehouse_id.partner_id.street"/>
                                </strong>
                                <strong>
                                    <span t-esc="o.picking_type_id.warehouse_id.partner_id.street2"/>
                                </strong>
                                <strong>
                                    <span t-esc="o.picking_type_id.warehouse_id.partner_id.district_id.name"/>
                                </strong>
                                <strong>
                                    <span t-esc="o.picking_type_id.warehouse_id.partner_id.state_id.name"/>
                                </strong>
                                <strong>
                                    <span t-esc="o.picking_type_id.warehouse_id.partner_id.country_id.name"/>
                                </strong>
                            </p>
                            <p style="margin-bottom:0px">Received for storing from
                                <strong>
                                    <span t-esc="o.partner_id.name"/>
                                </strong>
                                <strong>
                                    <span t-esc="o.partner_id.street"/>
                                </strong>
                                <strong>
                                    <span t-esc="o.partner_id.street2"/>
                                </strong>
                                <strong>
                                    <span t-esc="o.partner_id.district_id.name"/>
                                </strong>
                                <strong>
                                    <span t-esc="o.partner_id.state_id.name"/>
                                </strong>
                                <strong>
                                    <span t-esc="o.partner_id.country_id.name"/>
                                </strong>
                            </p>
                            <p style="margin-bottom:0px">Commodity with the following descriptions:-</p>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
        <table name="stock_move_table" position="replace"/>
        <table name="stock_move_line_table" position="replace">
            <table class="table table-sm" name="stock_move_table">
                <thead>
                    <tr>
                        <th>
                            Type and Origin of Commodity
                        </th>
                        <th>
                            Number of Package(s)
                        </th>
                        <th>
                            Physical Weight (kg)
                        </th>
                        <th>
                            Grade
                        </th>
                        <th>
                            Class
                        </th>
                        <t t-set="heads" t-value="o.quality_line"/>
                        <th t-foreach="heads" t-as="head">
                            <span t-esc="head.name.name"/>
                        </th>

                        <th>
                            Storage Instructions
                        </th>
                    </tr>
                </thead>
                <tbody>
                    <t t-set="lines" t-value="o.move_line_ids"/>
                    <tr t-foreach="lines" t-as="move">
                        <td>
                            <span t-field="move.product_id"/>
                        </td>
                        <td>
                            <span t-field="o.bag_count"/>
                        </td>
                        <td>
                            <span t-field="o.qty_done"/>
                        </td>
                        <td>
                            <span t-field="o.grade"/>
                        </td>
                        <td/>
                        <t t-set="datas" t-value="o.quality_line"/>
                        <td t-foreach="datas" t-as="data">
                            <span t-esc="data.field_value"/>
                        </td>
                        <td>
                            <span t-field="o.note"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="2">
                            <strong>Physical Weight in words</strong>
                        </td>
                        <td colspan="9">
                            <span t-esc="o.amount_to_words(o.qty_done)"/>
                        </td>

                    </tr>
                </tbody>
            </table>
            <div class="row">
                <div class="col-12">
                    <div class="panel panel-default">
                        <div class="panel-body">
                            <p style="margin-bottom:0px">1. The commodity are fully insured according to insurance
                                policy No.
                                <strong>
                                    <t t-if="o.get_policy_number() is None">
                                        ..........
                                    </t>
                                    <t t-else=" ">
                                        <span t-esc="o.get_policy_number().name"/>
                                    </t>
                                </strong>
                                of
                                <strong>
                                    <t t-if="o.get_policy_number() is None">
                                        ..........
                                    </t>
                                    <t t-else=" ">
                                        <span t-esc="o.get_policy_number().start_date"/>
                                    </t>
                                </strong>
                            </p>
                            <p style="margin-bottom:0px">2. The nature and fact of Ownership of the commodity
                                <strong>
                                    <span t-esc="o.check_depositor()"/>
                                </strong>
                            </p>
                            <p style="margin-bottom:0px">3. Warehouse Operator / Collateral manager hereby agree to
                                undertake the following:-
                            </p>
                            <p style="margin-bottom:0px">(i) To maintain quality and quantity as above mentioned until
                                <strong>
                                    <span t-esc="o.get_maintain_period()"/>
                                </strong>
                                with consideration
                                for deterioration by
                                <strong>
                                    <span t-esc="o.product_id.standard_quality"/>
                                </strong>
                                of quality and weight loss
                                <strong>
                                    <span t-esc="o.product_id.weight_loss"/>
                                    ,
                                </strong>
                                as specified within
                                <strong>
                                    <span t-esc="o.product_id.deterioration_days"/>
                                    days.
                                </strong>
                            </p>
                            <p style="margin-bottom:0px">(ii) With no financial interest in the commodity covered by
                                this receipt except a lien on
                                the commodity
                            </p>
                            <p style="margin-bottom:0px">(iii) For a fee of Tsh
                                <strong>
                                    <span t-esc="'{0:,.2f}'.format(o.product_id.commodity_fee)"/>
                                </strong>
                                as lien until
                                <strong>
                                    <span t-esc="o.get_licence_number().end_date"/>
                                </strong>
                            </p>

                            <p style="margin-bottom:0px">4. The Holder of this Warehouse Receipt hereby agrees to
                                undertake the following:-
                            </p>
                            <p style="margin-bottom:0px">(i) To pay the Warehouse Operator / Collateral Manager the
                                specified Fee as lien
                            </p>
                            <p style="margin-bottom:0px">(ii) To inform the Warehouse Operator/ Collateral Manager of
                                any mis-delivery or
                                liabilities incurred by use of this Receipt.
                            </p>
                            <p style="margin-bottom:0px">5. The receipt is
                                <strong>
                                    <span t-esc="o.check_negotiable()"/>
                                </strong>
                            </p>
                            <p style="margin-bottom:0px; margin-top:10px;">Depositor's Full Name
                                ....................................................................... Signature
                                .........................................
                            </p>
                            <br/>
                            <p style="margin-bottom:0px">Authorized person of the
                                Warehouse
                                ....................................................................... Stamp/Signature
                                .................................
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row" style="margin-top:35px;margin-bottom:30px;">
                <div class="col-4"/>
                <div class="col-4" align="center">
                    <img t-att-src="'/report/barcode/?type=QR&amp;value=%s/verify/receipt/?receipt_no=%s&amp;width=120&amp;height=120'%(o.get_base_url(),o.receipt_no)"/>
                    <br/>
                    <strong style="margin-top:10px;">SCAN QR CODE TO VERIFY</strong>
                </div>
                <div class="col-4"/>
            </div>
        </table>
    </template>

