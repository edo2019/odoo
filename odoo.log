    <!--  Success Receipt template  -->
    <template id="receipt_success" inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-set="no_breadcrumbs">True</t>
            <t t-set="title">Verify Receipt</t>
            <div class="container bg-light p-1 mt-2">
                <div class="row mt-2">
                    <div class="col">
                        <a class="btn btn-primary rounded-0 m-3" href="/verify/receipt/form">
                            <i class="fa fa-home"/> Go Back</a>
                    </div>
                </div>
                <div class="row mt-2">
                    <div class="col-2"/>
                    <div class="col-8">
                        <div class="alert alert-success text-center" style="font-size:1.5vw;">
                            Your Receipt with No:
                            <strong>
                                <span t-esc="receipt.display_name"/>
                            </strong>
                            is Valid!
                        </div>
                    </div>
                    <div class="col-2"/>
                </div>
                <div class="row">
                    <div class="col-1"/>
                    <div class="col-10 col-xs-12">

                        <div class="container-fluid">
                            <div class="row">
                                <div class="col">Receive From</div>
                                <div class="col">
                                    <strong>
                                        <span t-esc="receipt.partner_id.name"/>
                                    </strong>
                                </div>
                                <div class="col">Date Issued</div>
                                <div class="col">
                                    <strong>
                                        <span t-esc="receipt.scheduled_date"/>
                                    </strong>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col">Tally Sheet Number</div>
                                <div class="col">
                                    <strong>
                                        <span t-esc="receipt.tally_sheet_no"/>
                                    </strong>
                                </div>
                                <div class="col">GRN Number</div>
                                <div class="col">
                                    <strong>
                                        <span t-esc="receipt.origin"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">Weight Note Number</div>
                                <div class="col">
                                    <strong>
                                        <span t-esc="receipt.wnote_no"/>
                                    </strong>
                                </div>
                                <div class="col">PDN</div>
                                <div class="col">
                                    <strong>
                                        <span t-esc="receipt.pdn"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">Grade</div>
                                <div class="col">
                                    <strong>
                                        <span t-esc="receipt.grade"/>
                                    </strong>
                                </div>
                                <div class="col">Product</div>
                                <div class="col">
                                    <strong>
                                        <span t-esc="receipt.warehouse_book.product_id.name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col">Negotiable</div>
                                <div class="col">
                                    <strong>
                                        <t t-if="receipt.is_negotiable">
                                            YES
                                        </t>
                                        <t t-else=" ">
                                            NO
                                        </t>
                                    </strong>
                                </div>
                                <div class="col"/>
                                <div class="col"/>
                            </div>
                        </div>


                    </div>
                    <div class="col-1"/>
                </div>
                <div class="row">
                    <div class="col-1"/>
                    <div class="col-10 col-sm-12">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>
                                        Type and Origin of Commodity
                                    </th>
                                    <th>
                                        Number of Package(s)
                                    </th>
                                    <th>
                                        Physical Weight (kg)
                                    </th>
                                    <!--                                    <th>-->
                                    <!--                                        Grade-->
                                    <!--                                    </th>-->
                                    <!--                                    <th>-->
                                    <!--                                        Class-->
                                    <!--                                    </th>-->
                                    <!--                                    <t t-set="heads" t-value="receipt.quality_line"/>-->
                                    <!--                                    <th t-foreach="heads" t-as="head">-->
                                    <!--                                        <span t-esc="head.name.name"/>-->
                                    <!--                                    </th>-->

                                    <!--                                    <th>-->
                                    <!--                                        Storage Instructions-->
                                    <!--                                    </th>-->
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lines" t-value="receipt.move_lines.filtered(lambda x: x.product_uom_qty)"/>
                                <tr t-foreach="lines" t-as="move">
                                    <td>
                                        <span t-field="move.product_id"/>
                                    </td>
                                    <td>
                                        <span t-field="receipt.bag_count"/>
                                    </td>
                                    <td>
                                        <span t-field="receipt.qty_done"/>
                                    </td>
                                    <!--                                    <td>-->
                                    <!--                                        <span t-field="receipt.grade"/>-->
                                    <!--                                    </td>-->
                                    <!--                                    <td></td>-->
                                    <!--                                    <t t-set="datas" t-value="receipt.quality_line"/>-->
                                    <!--                                    <td t-foreach="datas" t-as="data">-->
                                    <!--                                        <span t-esc="data.field_value"/>-->
                                    <!--                                    </td>-->
                                    <!--                                    <td>-->
                                    <!--                                        <span t-field="receipt.note"/>-->
                                    <!--                                    </td>-->
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-1"/>
                </div>
            </div>

        </xpath>

    </template>

    <!--  Not Found receipt template  -->
    <template id="receipt_not_found" inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-set="no_breadcrumbs">True</t>
            <t t-set="title">Verify Receipt</t>
            <div class="container">
                <div class="row mt-2">
                    <div class="col">
                        <a class="btn btn-primary rounded-0 m-3" href="/verify/receipt/form">
                            <i class="fa fa-home"/> Go Back</a>
                    </div>
                </div>
                <div class="row mt-5">
                    <div class="col-2"/>
                    <div class="col-8">
                        <div class="alert alert-danger text-center" style="font-size:1.5vw;">
                            Your Receipt with No:
                            <strong>
                                <span t-esc="receipt_no"/>
                            </strong>
                            is Not Found!
                        </div>
                    </div>
                    <div class="col-2"/>
                </div>
            </div>
        </xpath>
    </template>

    <!--  Verification Form template  -->
    <template id="receipt_verify_form" inherit_id="portal.portal_sidebar" primary="True">
        <xpath expr="//div[hasclass('o_portal_sidebar')]" position="inside">
            <t t-set="no_breadcrumbs">True</t>
            <t t-set="title">Verify Receipt</t>
            <div class="container">
                <div class="row mt-5">
                    <div class="col-4"/>
                    <div class="col-4" align="center">
                        <form method="GET" action="/verify/receipt/">
                            <label class="lead">Enter Your Receipt Number to verify</label>
                            <input name="receipt_no" type="text" pattern="[0-9]*" required="True" class="form-control m-3"/>
                            <button type="submit" class="btn btn-success rounded-0">VERIFY RECEIPT</button>
                        </form>
                    </div>
                    <div class="col-4"/>
                </div>
            </div>
        </xpath>
    </template>


</odoo>
