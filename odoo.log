                        <button name="%(stock.action_stock_report)d" icon="fa-arrow-up" class="oe_stat_button" string="Traceability" type="action" attrs="{'invisible': ['|', ('state', '!=', 'done'), ('has_tracking', '=', False)]}" groups="stock.group_production_lot"/>
                        <!-- Use the following button to avoid onchange on one2many -->
                        <button name="action_picking_move_tree" class="oe_stat_button" icon="fa-arrows-v" type="object" help="List view of operations" groups="base.group_no_one" attrs="{'invisible': ['|', '&amp;', ('show_operations', '=', True), '|', ('is_locked', '=', True), ('state', '=', 'done'), '&amp;', ('state', '=', 'done'), ('is_locked', '=', True)]}" context="{'picking_type_code': picking_type_code, 'default_picking_id': id, 'form_view_ref':'stock.view_move_form', 'address_in_id': partner_id, 'default_picking_type_id': picking_type_id, 'default_location_id': location_id, 'default_location_dest_id': location_dest_id}">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Operations</span>
                            </div>
                        </button>
                    </div>
                    <h1 class="d-none d-md-block">
                        <field name="name" attrs="{'invisible': [('name','=','/')]}"/>
                    </h1>
                    <group>
                        <group>
                            <field name="receipt_id" domain="[('bought','=',False),('picking_type_code','=','incoming'),('state','=','done'),('is_blocked','=',False)]" required="1" options="{'no_open': True, 'no_create': True}" context="{'tree_view_ref':'custom_wrrb.vpicktree_receive','delivery_form': True}"/>
                            <field name="receipt_qty_done"/>
                            <field name="depositor"/>
                            <div class="o_td_label">
                                <label for="partner_id" string="Buyer" style="font-weight:bold;" attrs="{'invisible': [('picking_type_code', '!=', 'outgoing')]}"/>
                            </div>
                            <field name="partner_id" nolabel="1" domain="[('is_customer','=',True)]" required="1" context="{'delivery_form': True,}"/>
                            <field name="picking_type_id" attrs="{'readonly': [('state', '!=', 'draft')]}" invisible="1"/>
                            <field name="location_id" options="{'no_create': True}" groups="stock.group_stock_multi_locations" attrs="{'invisible': [('picking_type_code', '=', 'incoming')]}"/>
                            <field name="location_dest_id" invisible="1"/>
                            <field name="bags_available"/>
                            <field name="backorder_id" attrs="{'invisible': [('backorder_id','=',False)]}"/>
                            <field name="grade"/>
                            <field name="moisture_out"/>
                        </group>
                        <group>
                            <field name="scheduled_date" string="Date Issued" attrs="{'required': [('id', '!=', False)]}"/>
                            <field name="date_done" string="Effective Date" attrs="{'invisible': [('state', '!=', 'done')]}"/>
                            <field name="origin" string="Warehouse Issue Note" placeholder="e.g. 23032"/>
                            <field name="order_number" placeholder="e.g. ORDER 23032"/>
                            <field name="owner_id" groups="stock.group_tracking_owner" attrs="{'invisible': [('picking_type_code', '!=', 'incoming')]}"/>
                            <field name="warranty_number" placeholder="e.g. TANECU LTD/000/2345" required="1"/>
                        </group>
                    </group>
                    <notebook>
                        <!-- Reservation hidden -->
                        <page string="Detailed Operations" attrs="{'invisible': ['|', ('show_operations', '=', False), ('show_reserved', '=', True)]}">
                            <field name="move_line_nosuggest_ids" attrs="{'readonly': ['|', '|', ('show_operations', '=', False), ('state', '=', 'cancel'), '&amp;', ('state', '=', 'done'), ('is_locked', '=', True)]}" context="{'tree_view_ref': 'stock.view_stock_move_line_detailed_operation_tree', 'default_picking_id': id, 'default_location_id': location_id, 'default_location_dest_id': location_dest_id, 'default_company_id': company_id}"/>
                            <field name="package_level_ids_details" context="{'default_location_id': location_id, 'default_location_dest_id': location_dest_id, 'default_company_id': company_id}" attrs="{'readonly': [('state', '=', 'done')], 'invisible': ['|', ('picking_type_entire_packs', '=', False), ('show_operations', '=', False)]}"/>
                            <button class="oe_highlight" name="put_in_pack" type="object" string="Put in Pack" attrs="{'invisible': [('state', 'in', ('draft', 'done', 'cancel'))]}" groups="stock.group_tracking_lot"/>
                        </page>

                        <!-- Reservation displayed -->
                        <page string="Detailed Operations" attrs="{'invisible': ['|', ('show_operations', '=', False), ('show_reserved', '=', False)]}">
                            <field name="move_line_ids_without_package" attrs="{'readonly': ['|', '|', ('show_operations', '=', False), ('state', '=', 'cancel'), '&amp;', ('state', '=', 'done'), ('is_locked', '=', True)]}" context="{'tree_view_ref': 'stock.view_stock_move_line_detailed_operation_tree', 'default_picking_id': id, 'default_location_id': location_id, 'default_location_dest_id': location_dest_id, 'default_company_id': company_id}"/>
                            <field name="package_level_ids_details" context="{'default_location_id': location_id, 'default_location_dest_id': location_dest_id, 'default_company_id': company_id}" attrs="{'readonly': [('state', '=', 'done')], 'invisible': ['|', ('picking_type_entire_packs', '=', False), ('show_operations', '=', False)]}"/>
                            <button class="oe_highlight" name="put_in_pack" type="object" string="Put in Pack" attrs="{'invisible': [('state', 'in', ('draft', 'done', 'cancel'))]}" groups="stock.group_tracking_lot"/>
                        </page>
                        <page string="Auction Details" colspan="6" name="auction">
                            <field name="auction_line">
                                <tree string="Auction Details" editable="top">
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="price"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Transport Details" colspan="6" name="transport">
                            <field name="transport_line">
                                <tree string="Transport Details" editable="top">
                                    <field name="name"/>
                                    <field name="escorter_name"/>
                                    <field name="car_registration"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Operations" invisible="1">
                            <field name="move_ids_without_package" attrs="{'readonly': ['|', '&amp;', ('show_operations', '=', True), '|', ('is_locked', '=', True), ('state', '=', 'done'), '&amp;', ('state', '=', 'done'), ('is_locked', '=', True)]}" context="{'default_company_id': company_id, 'picking_type_code': picking_type_code, 'default_picking_id': id, 'form_view_ref':'stock.view_move_form', 'address_in_id': partner_id, 'default_picking_type_id': picking_type_id, 'default_location_id': location_id, 'default_location_dest_id': location_dest_id}">
                                <tree decoration-danger="not parent.immediate_transfer and state != 'done' and quantity_done &gt; reserved_availability and show_reserved_availability" decoration-muted="scrapped == True or state == 'cancel' or (state == 'done' and is_locked == True)" string="Stock Moves" editable="bottom">
                                    <field name="company_id" invisible="1"/>
                                    <field name="name" invisible="1"/>
                                    <field name="state" invisible="1" readonly="0"/>
                                    <field name="picking_type_id" invisible="1"/>
                                    <field name="location_id" invisible="1"/>
                                    <field name="location_dest_id" invisible="1"/>
                                    <field name="scrapped" invisible="1"/>
                                    <field name="picking_code" invisible="1"/>
                                    <field name="product_type" invisible="1"/>
                                    <field name="show_details_visible" invisible="1"/>
                                    <field name="show_reserved_availability" invisible="1"/>
                                    <field name="show_operations" invisible="1" readonly="1"/>
                                    <field name="additional" invisible="1"/>
                                    <field name="has_move_lines" invisible="1"/>
                                    <field name="is_locked" invisible="1"/>
                                    <field name="product_uom_category_id" invisible="1"/>
                                    <field name="has_tracking" invisible="1"/>
                                    <field name="display_assign_serial" invisible="1"/>
                                    <field name="product_id" required="1" attrs="{'readonly': ['|', '&amp;', ('state', '!=', 'draft'), ('additional', '=', False), ('has_move_lines', '=', True)]}"/>
                                    <field name="description_picking" string="Description" optional="hide"/>
                                    <field name="date_expected" optional="hide"/>
                                    <field name="is_initial_demand_editable" invisible="1"/>
                                    <field name="is_quantity_done_editable" invisible="1"/>
                                    <field name="loti_id"/>
                                    <field name="bag_count"/>
                                    <field name="product_uom_qty" string="Demand" attrs="{'column_invisible': [('parent.immediate_transfer', '=', True)], 'readonly': [('is_initial_demand_editable', '=', False)]}"/>
                                    <field name="reserved_availability" string="Reserved" attrs="{'column_invisible': (['|','|', ('parent.state','=', 'done'), ('parent.picking_type_code', '=', 'incoming'), ('parent.immediate_transfer', '=', True)])}"/>
                                    <field name="quantity_done" string="Done" attrs="{'readonly': [('is_quantity_done_editable', '=', False)]}"/>
                                    <field name="product_uom" attrs="{'readonly': [('state', '!=', 'draft'), ('additional', '=', False)]}" options="{'no_open': True, 'no_create': True}" string="Unit of Measure" groups="uom.group_uom"/>
                                    <button name="action_show_details" string="Register lots, packs, location" type="object" icon="fa-list" width="0.1" attrs="{'invisible': [('show_details_visible', '=', False)]}" options="{&quot;warn&quot;: true}"/>
                                    <button name="action_assign_serial" type="object" icon="fa-plus-square" width="0.1" role="img" title="Assign Serial Numbers" attrs="{'invisible': ['|', ('display_assign_serial', '=', False), ('show_operations', '=', False)]}"/>
                                </tree>
                                <form string="Stock Moves">
                                    <header>
                                        <field name="state" widget="statusbar"/>
                                    </header>
                                    <group>
                                        <field name="product_uom_category_id" invisible="1"/>
                                        <field name="additional" invisible="1"/>
                                        <field name="has_move_lines" invisible="1"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="product_id" required="1" attrs="{'readonly': ['|', '&amp;', ('state', '!=', 'draft'), ('additional', '=', False), ('has_move_lines', '=', True)]}"/>
                                        <field name="is_initial_demand_editable" invisible="1"/>
                                        <field name="is_quantity_done_editable" invisible="1"/>
                                        <field name="product_uom_qty" string="Initial Demand" attrs="{'invisible': [('parent.immediate_transfer', '=', True)], 'readonly': [('is_initial_demand_editable', '=', False)]}"/>
                                        <field name="reserved_availability" string="Reserved" attrs="{'invisible': (['|','|', ('parent.state','=', 'done'), ('parent.picking_type_code', '=', 'incoming'), ('parent.immediate_transfer', '=', True)])}"/>
                                        <field name="quantity_done" string="Done" attrs="{'readonly': [('is_quantity_done_editable', '=', False)]}"/>
                                        <field name="product_uom" attrs="{'readonly': [('state', '!=', 'draft'), ('additional', '=', False)]}" options="{'no_open': True, 'no_create': True}" string="Unit of Measure" groups="uom.group_uom"/>
                                        <field name="description_picking" string="Description"/>
                                    </group>
                                </form>
                            </field>
                            <field name="id" invisible="1"/>
                            <field name="package_level_ids" context="{'default_location_id': location_id, 'default_location_dest_id': location_dest_id, 'default_company_id': company_id}" attrs="{'readonly': [('state', '=', 'done')], 'invisible': ['|', ('picking_type_entire_packs', '=', False), ('show_operations', '=', True)]}"/>
                            <button class="oe_highlight" name="put_in_pack" type="object" string="Put in Pack" attrs="{'invisible': [('state', 'in', ('draft', 'done', 'cancel'))]}" groups="stock.group_tracking_lot"/>
                        </page>
                        <page string="Additional Info" name="extra" invisible="1">
                            <group>
                                <group string="Other Information" name="other_infos">
                                    <field name="picking_type_code" invisible="1"/>
                                    <field name="move_type" attrs="{'invisible': [('picking_type_code', '=', 'incoming')]}"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="user_id"/>
                                    <field name="group_id" groups="base.group_no_one"/>
                                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" force_save="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Note" name="note">
                            <field name="note" string="Note" placeholder="Add an internal note that will be printed on the Picking Operations sheet"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!--    Export report action & view-->
    <record id="export_receiving_report_form" model="ir.ui.view">
        <field name="name">warehouse.receipt.wizard.view</field>
        <field name="model">warehouse.receipt.wizard</field>
        <field name="arch" type="xml">
            <form string="Receiving Report">
                <group col="4">
                    <field name="warehouse" widget="many2many_tags"/>
                    <field name="commodity" widget="many2many_tags"/>
                </group>
                <group col="4">
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <group>
                    <field name="season"/>
                </group>
                <footer>
                    <button name="print_pdf_report" string="Export to PDF" type="object" default_focus="1" class="oe_highlight"/>
                    <button name="print_excel_report" string="Export to Excel" type="object" default_focus="1" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="export_delivery_report_form" model="ir.ui.view">
        <field name="name">warehouse.delivery.wizard.view</field>
        <field name="model">warehouse.delivery.wizard</field>
        <field name="arch" type="xml">
            <form string="Delivery Report">
                <group col="4">
                    <field name="warehouse" widget="many2many_tags"/>
                    <field name="commodity" widget="many2many_tags"/>
                </group>
                <group col="4">
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>
                <group>
                    <field name="season"/>
                </group>
                <footer>
                    <button name="print_pdf_report" string="Export to PDF" type="object" default_focus="1" class="oe_highlight"/>
                    <button name="print_excel_report" string="Export to Excel" type="object" default_focus="1" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>


    <record id="action_export_receiving_report_form" model="ir.actions.act_window">
        <field name="name">Export Report</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="export_receiving_report_form"/>
        <field name="target">new</field>
    </record>


    <record id="vpicktree_receive" model="ir.ui.view">
        <field name="name">stock.picking.tree</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">

            <tree string="Receiving List" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'" decoration-danger="state not in ('cancel', 'done') and scheduled_date &lt; current_date" edit="false" create="false" delete="false" js_class="receipt_report_list">

                <field name="scheduled_date" string="Date"/>
                <field name="display_name"/>
                <field name="partner_id" string="Name of Depositor"/>
                <field name="warehouse_id" string="Warehouse"/>
                <field name="picking_type_code" invisible="1"/>
                <field name="picking_type_id" invisible="1"/>
                <field name="bag_count" sum="Total Bags"/>
                <field name="qty_done" string="Weight" sum="Total Weight"/>
                <field name="product_uom"/>
                <field name="tally_sheet_no"/>
                <field name="wnote_no"/>
                <field name="pdn"/>
                <field name="origin" string="GRN"/>
                <field name="delivery_state"/>
                <field name="state" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" invisible="1"/>
                <field name="user_id" string="Responsible User" optional="hide"/>
                <field name="date" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="vpicktree_delivery" model="ir.ui.view">
        <field name="name">stock.picking.tree</field>
        <field name="model">stock.picking</field>
        <field name="groups_id" eval="[(4, ref('stock.group_stock_manager','stock.group_stock_user'))]"/>
        <field name="arch" type="xml">
            <tree string="Delivery Receipt" multi_edit="1" decoration-info="state == 'draft'" decoration-muted="state == 'cancel'" decoration-danger="state not in ('cancel', 'done') and scheduled_date &lt; current_date" edit="false" create="false" delete="false" js_class="delivery_report_list">
                <!--<field name="receipt_no"/>-->
                <field name="scheduled_date" string="Date" optional="show"/>
                <field name="receipt_no" string="Warehouse Receipt" invisible="1"/>
                <field name="warehouse_receipt"/>
                <field name="order_number"/>
                <field name="warranty_number"/>
                <!-- <field name="delivery_product_id"/> -->
                <field name="depositor"/>
                <field name="partner_id" string="Buyer" optional="show"/>
                <field name="warehouse_id" string="Warehouse"/>
                <field name="bags_in" sum="Total Received Bags"/>
                <field name="qty_in" sum="Total Received Weight"/>
                <field name="bag_count" string="Bags Out" sum="Total Delivered Bags"/>
                <field name="qty_done" string="Quantity Out" sum="Total Delivered Weight"/>
                <field name="kg_diff" sum="Kg Difference"/>
                <field name="product_uom"/>
                <field name="moisture_out"/>
                <!-- <field name="bag_diff" optional="hide"/> -->
                <!-- <field name="kg_diff" optional="hide"/> -->
                <field name="days_in_warehouse"/>
                <!-- <field name="shrinkage" /> -->
                <field name="user_id" optional="hide"/>
                <field name="state" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="stock.stock_picking_type_action" model="ir.actions.act_window">
        <field name="name">Overview</field>
    </record>

    <record id="stock.action_picking_form" model="ir.actions.act_window">
        <field name="name">New Receipt</field>
        <field name="res_model">stock.picking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="domain"/>
        <field name="context">{
            'search_default_picking_type_id': [active_id],
            'default_picking_type_id': active_id,
            'default_immediate_transfer': True,
            'contact_display': 'partner_address',
            'receipt_form': True,
            }
        </field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new transfer
            </p>
            <p>
                Transfers allow you to move crop from one location to another.
            </p>
        </field>
    </record>

    <record id="action_delivery_form" model="ir.actions.act_window">
        <field name="name">New Delivery</field>
        <field name="res_model">stock.picking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">form</field>
        <field name="domain"/>
        <field name="context">{
            'search_default_picking_type_id': [active_id],
            'default_picking_type_id': active_id,
            'default_immediate_transfer': True,
            'contact_display': 'partner_address',
            'delivery_form': True,
            }
        </field>
        <field name="search_view_id" ref="view_picking_internal_search_for_delivery"/>
        <field name="view_id" ref="view_delivery_form"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new delivery order
            </p>
            <p>
                Delivery Orders allow you to move crops from your warehouse to Customer.
            </p>
        </field>
    </record>

    <record id="stock_picking_type_kanban" model="ir.ui.view">
        <field name="name">stock.picking.type.kanban</field>
        <field name="model">stock.picking.type</field>
        <field name="inherit_id" ref="stock.stock_picking_type_kanban"/>
        <field name="arch" type="xml">
            <data><xpath expr="//templates/t/div/div/div[hasclass('o_kanban_card_content')]/div/div[1]" position="before">
                <div class="col-6 o_kanban_primary_left">
                    <field name="valid_licence" invisible="1"/>
                    <t t-if="record.code.raw_value =='outgoing'">
                        <button class="btn btn-primary" name="%(action_delivery_form)d" type="action" attrs="{'invisible':[('valid_licence', '=', False)]}">
                            <span>Add New</span>
                        </button>
                    </t>
                    <t t-if="record.code.raw_value =='incoming'">
                        <button class="btn btn-primary" name="%(stock.action_picking_form)d" type="action" attrs="{'invisible':[('valid_licence', '=', False)]}">
                            <span>Add New</span>
                        </button>
                    </t>
                    <t t-if="record.code.raw_value =='internal'">
                        <button class="btn btn-primary" name="%(stock.action_picking_form)d" type="action" attrs="{'invisible':[('valid_licence', '=', False)]}">
                            <span>Add New</span>
                        </button>
                    </t>
                </div>
            </xpath>
            <xpath expr="//templates/t/div/div[1]" position="attributes">
                <attribute name="attrs">{'invisible':[('valid_licence', '=', False)]}</attribute>
            </xpath>
            <xpath expr="//templates/t/div/div[1]" position="before">
                <div attrs="{'invisible':[('valid_licence', '=', True)]}">
                    <div t-attf-class="o_kanban_card_header">
                        <div class="o_kanban_card_header_title">
                            <div class="o_primary" t-if="!selection_mode">
                                <field name="name"/>
                            </div>
                            <div class="o_primary" t-if="selection_mode">
                                <field name="name"/>
                            </div>
                            <div class="o_secondary">
                                <field class="o_secondary" name="warehouse_id"/>
                                <p>
                                    <strong>Not Licensed</strong>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </data></field>
    </record>

    <record id="stock_picking_receiving_picking_type" model="ir.actions.act_window">
        <field name="name">Receiving</field>
        <field name="res_model">stock.picking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
        <field name="domain">[('picking_type_code','=','incoming')]</field>
        <field name="context">{'contact_display': 'partner_address','receipt_form': True,}</field>
        <field name="views">[['vpicktree_receive', 'tree'],['view_picking_form', 'form']]</field>
        <field name="view_id" ref="vpicktree_receive"/>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Receive commodity to Warehouse
            </p>
            <p>
                Receipts allow you to record and issue WR Electronically.
            </p>
        </field>
    </record>

    <record id="stock_picking_delivery_picking_type" model="ir.actions.act_window">
        <field name="name">Delivery</field>
        <field name="res_model">stock.picking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
        <field name="domain">[('picking_type_code','=','outgoing')]</field>
        <field name="context">{'contact_display': 'partner_address','delivery_form': True,}</field>
        <!--        <field name="views">[['vpicktree_delivery', 'tree'],['view_delivery_form', 'form']]</field>-->
        <field name="search_view_id" ref="view_picking_internal_search_for_delivery"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
